# Turso (si se omite, se usa file:local.db)
TURSO_DATABASE_URL=libsql://coleccionables-<usuario>.turso.io
TURSO_AUTH_TOKEN=
# URL pública del bucket de imágenes (Cloudflare R2). Si se omite, /catalogo (carpeta public)
NEXT_PUBLIC_IMAGES_BASE_URL=https://pub-xxxx.r2.dev
# Login con Google (opcional). Redirección autorizada: <url del sitio>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
